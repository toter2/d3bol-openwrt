#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
WWW=/usr/share/d3bol-panel/www
port_busy() { netstat -ltn 2>/dev/null | grep -q "[:.]$1 "; }
start_service() {
local enabled address host port
config_load d3bol-panel
config_get_bool enabled config enabled 1
[ "$enabled" = 1 ] || return 0
config_get address config address '0.0.0.0:2017'
port=${address##*:}
host=${address%:*}
[ -n "$port" ] || port=2017
[ -n "$host" ] && [ "$host" != "$address" ] || host=0.0.0.0
if port_busy "$port" && pidof v2raya >/dev/null; then port=2018; fi
echo "$port" > /tmp/d3bol-panel.port
procd_open_instance web
if [ "$host" = 0.0.0.0 ]; then
procd_set_param command /usr/sbin/uhttpd -f -h "$WWW" -x /cgi-bin -t 180 -T 60 -n 12 -N 64 -p "0.0.0.0:$port" -p "[::]:$port"
else
procd_set_param command /usr/sbin/uhttpd -f -h "$WWW" -x /cgi-bin -t 180 -T 60 -n 12 -N 64 -p "$host:$port"
fi
procd_set_param respawn
procd_close_instance
}
service_triggers() {
procd_add_reload_trigger "d3bol-panel"
}
