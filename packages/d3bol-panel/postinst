#!/bin/sh
[ -n "${IPKG_INSTROOT}" ] && exit 0
chmod 755 /usr/sbin/d3bol-panel /etc/init.d/d3bol-panel /etc/init.d/d3bol-core /usr/share/d3bol-panel/www/cgi-bin/api
mkdir -p /etc/d3bol-panel && chmod 700 /etc/d3bol-panel
rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache
/etc/init.d/rpcd reload
/etc/init.d/d3bol-core enable
/etc/init.d/d3bol-panel enable
/etc/init.d/d3bol-panel restart
# upgrade while connected: restart the core so the new settings (RAM saver etc.) take effect
grep -q '"enabled": true' /etc/d3bol-panel/settings.json 2>/dev/null && /etc/init.d/d3bol-core restart
sleep 1
P=$(cat /tmp/d3bol-panel.port 2>/dev/null || echo 2017)
IP=$(uci -q get network.lan.ipaddr | cut -d/ -f1)
echo "D3BOL Panel: http://${IP:-192.168.1.1}:$P"
exit 0
