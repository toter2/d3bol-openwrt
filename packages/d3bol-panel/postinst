#!/bin/sh
[ -n "${IPKG_INSTROOT}" ] && exit 0
chmod 755 /usr/sbin/d3bol-panel /etc/init.d/d3bol-panel /etc/init.d/d3bol-core /usr/share/d3bol-panel/www/cgi-bin/api
mkdir -p /etc/d3bol-panel && chmod 700 /etc/d3bol-panel

# compile ucode to this router's own bytecode (version-matched; hides source on the box)
mkbc() {
	[ -f "$1" ] || return 0
	command -v ucode >/dev/null 2>&1 || return 0
	# busybox stat has no -c, so test executability with the shell builtin instead
	if [ -x "$1" ]; then m=755; else m=644; fi
	# keep the file's own "#!" interpreter so the kernel can still exec it
	# (default -c rewrites it to "#!/usr/bin/env ucode")
	sb=$(head -1 "$1"); case "$sb" in
		"#!"*) flag="-cinterp=$(printf '%s' "${sb#\#!}" | awk '{print $1}')" ;;
		*)     flag="-c" ;;
	esac
	ucode $flag -o "$1.b" "$1" 2>/dev/null && [ -s "$1.b" ] && mv "$1.b" "$1" && chmod $m "$1" || rm -f "$1.b"
}
for f in /usr/share/ucode/d3bol_panel.uc /usr/share/d3bol-panel/www/cgi-bin/api /usr/sbin/d3bol-panel; do mkbc "$f"; done
# safety net: uhttpd answers 403 if the CGI is not executable
chmod 755 /usr/share/d3bol-panel/www/cgi-bin/api /usr/sbin/d3bol-panel 2>/dev/null
rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache
/etc/init.d/rpcd reload
/etc/init.d/d3bol-core enable
/etc/init.d/d3bol-panel enable
/etc/init.d/d3bol-panel restart
# upgrade while connected: restart the core so the new settings (RAM saver etc.) take effect
grep -q '"enabled": true' /etc/d3bol-panel/settings.json 2>/dev/null && /etc/init.d/d3bol-core restart
sleep 1
P=$(cat /tmp/d3bol-panel.port 2>/dev/null || echo 2017)
IP=$(uci -q get network.lan.ipaddr | cut -d/ -f1)
echo "D3BOL Panel: http://${IP:-192.168.1.1}:$P"
exit 0
