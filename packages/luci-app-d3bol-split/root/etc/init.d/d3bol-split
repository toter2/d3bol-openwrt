#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
LOCK=/var/lock/d3bol-split.lock
start_service() {
lock $LOCK
/usr/sbin/d3bol-split start >/dev/null 2>&1
lock -u $LOCK
procd_open_instance
procd_set_param command /bin/sh /usr/share/d3bol-split/loop.sh
procd_set_param respawn 3600 5 0
procd_close_instance
}
stop_service() {
lock $LOCK
/usr/sbin/d3bol-split stop >/dev/null 2>&1
lock -u $LOCK
}
reload_service() {
lock $LOCK
/usr/sbin/d3bol-split apply >/dev/null 2>&1
lock -u $LOCK
}
service_triggers() {
procd_add_reload_trigger "network"
procd_add_interface_trigger "interface.*.up" wan /etc/init.d/d3bol-split reload
}
