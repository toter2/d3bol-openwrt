#!/bin/sh
STATE=${D3L_STATE:-/etc/d3bol-lite}
INIT=${D3L_INIT:-/etc/init.d/v2raya}
LITE=${D3L_LITE:-/etc/init.d/d3bol-lite}
CONF=${D3L_CONF:-/etc/v2raya-lite}
STOCKCONF=${D3L_STOCKCONF:-/etc/v2raya}
LOG=${D3L_LOG:-/tmp/d3bol-lite.log}
say() { echo "$(date '+%H:%M:%S') $*" >> "$LOG"; }
is_on() { [ -f "$STATE/on" ]; }
wait_up() {
i=0
while [ $i -lt 40 ]; do
pidof v2raya >/dev/null && [ $i -ge 3 ] && { echo ok; return; }
sleep 1; i=$((i+1))
done
}
do_on() {
: > "$LOG"
is_on && { say "already on"; exit 0; }
[ -x "$LITE" ] || { say "ERR: lite package files missing"; exit 1; }
mkdir -p "$STATE"
if [ -x "$INIT" ] && "$INIT" enabled; then echo 1 > "$STATE/stock_enabled"; else echo 0 > "$STATE/stock_enabled"; fi
if [ ! -d "$CONF" ] && [ -d "$STOCKCONF" ]; then
say "copying your v2rayA settings to the lite core"
cp -a "$STOCKCONF" "$CONF"
fi
say "stopping stock v2rayA"
[ -x "$INIT" ] && { "$INIT" stop; "$INIT" disable; }
say "unpacking core to RAM and starting v2rayA 2.3.4 + xray 1.8.24"
touch "$STATE/on"
"$LITE" enable; "$LITE" start
if [ "$(wait_up)" = ok ]; then say "DONE: lite core is on"
else say "WARN: lite core did not come up — rolling back"; do_off_inner; fi
}
do_off_inner() {
"$LITE" stop; "$LITE" disable
rm -f "$STATE/on"
rm -rf /tmp/d3bol-lite/v2raya /tmp/d3bol-lite/xray   # give the RAM back
if [ -x "$INIT" ]; then
[ "$(cat "$STATE/stock_enabled" 2>/dev/null)" = 0 ] || "$INIT" enable
"$INIT" start
fi
}
do_off() {
: > "$LOG"
is_on || { say "already off"; exit 0; }
say "stopping lite core, starting stock v2rayA"
do_off_inner
[ "$(wait_up)" = ok ] && say "DONE: stock core restored" || say "WARN: stock v2rayA did not come up"
}
do_status() {
on=false; is_on && on=true
busy=false; { pgrep -f "d3bol-lite on" || pgrep -f "d3bol-lite off"; } >/dev/null && busy=true
last=$(tail -n1 "$LOG" 2>/dev/null | sed 's/"/\\"/g')
printf '{"installed":true,"on":%s,"busy":%s,"xray":"1.8.24","lite_v2raya":"2.3.4","log":"%s"}\n' "$on" "$busy" "$last"
}
case "$1" in
on) do_on ;;
off) do_off ;;
status) do_status ;;
*) echo "usage: d3bol-lite on|off|status"; exit 1 ;;
esac
