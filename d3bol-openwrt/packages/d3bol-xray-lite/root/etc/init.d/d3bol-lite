#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
PKG=/usr/share/d3bol-lite
RUN=/tmp/d3bol-lite
CONF=/etc/v2raya-lite
unpack() {
mkdir -p "$RUN"
for b in v2raya xray; do
[ -x "$RUN/$b" ] && [ "$(wc -c < "$RUN/$b")" = "$(cat "$PKG/$b.size" 2>/dev/null)" ] && continue
rm -f "$RUN/$b"
if command -v xzdec >/dev/null; then xzdec "$PKG/$b.xz" > "$RUN/$b.tmp"
elif command -v xz >/dev/null; then xz -dc "$PKG/$b.xz" > "$RUN/$b.tmp"
elif command -v xzcat >/dev/null; then xzcat "$PKG/$b.xz" > "$RUN/$b.tmp"
else logger -t d3bol-lite "no xz decompressor (install xzdec)"; return 1; fi
chmod 755 "$RUN/$b.tmp" && mv "$RUN/$b.tmp" "$RUN/$b"
done
}
geo_dir() {
for d in /usr/share/v2ray /usr/share/xray /etc/v2raya /root/.local/share/v2ray /root/.local/share/xray "$RUN/geo"; do
[ -s "$d/geosite.dat" ] && [ -s "$d/geoip.dat" ] && { echo "$d"; return; }
done
mkdir -p "$RUN/geo"; echo "$RUN/geo"   # last resort: v2rayA downloads into RAM, not flash
}
env_opt() {  # copy the stock v2raya uci options so both cores behave the same
local v; config_get v config "$1" "$2"
[ -n "$v" ] && procd_append_param env "V2RAYA_$(echo "$1" | tr a-z A-Z)=$v"
}
start_service() {
unpack || return 1
[ -d "$CONF" ] || mkdir -p "$CONF"
config_load v2raya
procd_open_instance
procd_set_param command "$RUN/v2raya"
procd_set_param env V2RAYA_CONFIG="$CONF" V2RAYA_V2RAY_BIN="$RUN/xray" V2RAYA_CORE_TYPE=xray \
V2RAYA_V2RAY_ASSETSDIR="$(geo_dir)" XDG_DATA_HOME="$RUN"
env_opt address 0.0.0.0:2017
env_opt ipv6_support auto
env_opt nftables_support auto
env_opt log_level info
env_opt log_max_days 3
env_opt transparent_hook
env_opt core_hook
env_opt plugin_manager
procd_set_param limits core="unlimited" nofile="1000000 1000000"
procd_set_param stdout 1
procd_set_param stderr 1
procd_set_param respawn
procd_close_instance
}
stop_service() {
pkill -x xray 2>/dev/null
return 0
}
