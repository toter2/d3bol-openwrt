#!/bin/sh /etc/rc.common
START=98
STOP=10
USE_PROCD=1
start_service() {
local j bin cfg assets gogc gml gmp enabled
config_load d3bol-panel
config_get_bool enabled config enabled 1
[ "$enabled" = 1 ] || { /usr/sbin/d3bol-panel rules-down >/dev/null 2>&1; return 0; }
if pidof v2raya >/dev/null && ! grep -q '"takeover": true' /etc/d3bol-panel/settings.json 2>/dev/null; then
logger -t d3bol-core "v2rayA is running, not starting"; return 0
fi
j=$(/usr/sbin/d3bol-panel prepare 2>/dev/null)
echo "$j" | grep -q '"ok": true' || { logger -t d3bol-core "not starting: $j"; return 0; }
bin=$(echo "$j" | jsonfilter -e '@.bin')
cfg=$(echo "$j" | jsonfilter -e '@.config')
assets=$(echo "$j" | jsonfilter -e '@.assets')
gogc=$(echo "$j" | jsonfilter -e '@.gogc')
gml=$(echo "$j" | jsonfilter -e '@.gomemlimit')
gmp=$(echo "$j" | jsonfilter -e '@.gomaxprocs')
procd_open_instance xray
procd_set_param command "$bin" run -c "$cfg"
procd_set_param env XRAY_LOCATION_ASSET="$assets" ${gogc:+GOGC=$gogc} ${gml:+GOMEMLIMIT=$gml} ${gmp:+GOMAXPROCS=$gmp}
procd_set_param limits nofile="1000000 1000000"
procd_set_param respawn 3600 5 10
procd_set_param stdout 0
procd_set_param stderr 1
procd_close_instance
/usr/sbin/d3bol-panel rules-up >/dev/null 2>&1
}
stop_service() {
/usr/sbin/d3bol-panel rules-down >/dev/null 2>&1
}
service_triggers() {
procd_add_reload_trigger "d3bol-panel"
}
